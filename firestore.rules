rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 1. FUNGSI BANTUAN (HELPER FUNCTIONS)
    // ==========================================
    
    // Cek apakah user sudah login
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Ambil data user yang sedang login
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Cek Role
    function isSuperMaster() {
      return isAuthenticated() && getUserData().role == 'SuperMaster';
    }
    function isAdmin() {
      return isAuthenticated() && getUserData().role in ['Admin', 'SuperMaster'];
    }
    function isEmployee() {
      return isAuthenticated() && getUserData().role == 'Employee';
    }

    // ==========================================
    // 2. ATURAN KOLEKSI: USERS (DATA KARYAWAN)
    // ==========================================
    match /users/{userId} {
      // Siapa saja yang boleh membaca profil? (Admin boleh semua, Karyawan hanya profilnya sendiri)
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Siapa yang boleh menambah user baru? (Hanya Admin)
      allow create: if isAdmin();
      
      // Siapa yang boleh mengubah (update) data?
      // - SuperMaster bebas mengubah apapun.
      // - Admin boleh mengubah, KECUALI memanipulasi role, status, atau lockedDeviceId (harus lewat Approval Queue)
      allow update: if isSuperMaster() || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'lockedDeviceId']));
      
      // Karyawan boleh update profil mereka SENDIRI, tapi HANYA untuk field "faceDescriptor" (saat mendaftar wajah awal)
      allow update: if request.auth.uid == userId 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['faceDescriptor'])
                    && resource.data.faceDescriptor == null; // Tidak boleh update kalau sudah terkunci
      
      allow delete: if isSuperMaster();
    }

    // ==========================================
    // 3. ATURAN KOLEKSI: APPROVAL QUEUE (ANTRIAN)
    // ==========================================
    match /approval_queue/{queueId} {
      allow read: if isAdmin();
      // Admin biasa boleh mengajukan request (Create)
      allow create: if isAdmin() && request.resource.data.requestedByAdmin == request.auth.uid;
      // Hanya SuperMaster yang boleh mengeksekusi/update status antrian
      allow update, delete: if isSuperMaster();
    }

    // ==========================================
    // 4. ATURAN KOLEKSI: ATTENDANCE (DATA ABSEN)
    // ==========================================
    match /attendance/{docId} {
      // Admin bisa baca semua, karyawan baca miliknya sendiri
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == resource.data.userId);
      
      // Aturan Ketat untuk Karyawan Absen:
      // 1. userId harus sesuai dengan akun yang login
      // 2. WAKTU HARUS JAM SERVER FIREBASE (Mencegah manipulasi jam HP)
      allow create: if isAuthenticated() 
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.checkIn.time == request.time;
      
      // Karyawan tidak boleh memanipulasi absen yang sudah masuk
      allow update, delete: if isSuperMaster();
    }

    // ==========================================
    // 5. ATURAN KOLEKSI: LOCATIONS & CONFIGS
    // ==========================================
    match /locations/{locId} {
      // Semua user boleh melihat titik koordinat kantor/pasar
      allow read: if isAuthenticated();
      // Hanya SuperMaster yang bisa menambah/mengubah titik geofence
      allow write: if isSuperMaster();
    }

    // ==========================================
    // 6. ATURAN KOLEKSI: AUDIT LOGS (BUKU BESAR)
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if isSuperMaster();
      // TIDAK ADA SATU MANUSIA PUN YANG BISA MENGHAPUS LOG INI DARI APLIKASI
      allow update, delete: if false; 
      allow create: if isSuperMaster() || (isAuthenticated() && request.resource.data.timestamp == request.time);
    }
  }
}
